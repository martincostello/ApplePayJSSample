{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "wwwroot/js/**/*.js",
      "wwwroot/ts/**/*.ts",
      "!wwwroot/ts/**/*.js"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "useConst": "error"
      },
      "suspicious": {
        "noDoubleEquals": {
          "level": "error",
          "options": {
            "ignoreNull": true
          }
        },
        "noVar": "error"
      }
    }
  },
  "assist": {
    "enabled": false
  }
}
